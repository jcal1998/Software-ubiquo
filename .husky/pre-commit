#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running pre-commit hooks..."

# Check formatting
npm run format:check
if [ $? -ne 0 ]; then
  echo "Code formatting check failed. Please run 'npm run format:write' to fix."
  exit 1
fi

# Run tests
npm test
if [ $? -ne 0 ]; then
  echo "Tests failed. Please fix them before committing."
  exit 1
fi

echo "Pre-commit checks passed!"